{
  "name": "kagojready",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pre-check for government application documents (decision layer, milestone 1)",
  "scripts": {
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "readiness": "tsx scripts/readiness.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "demo": "tsx src/server/index.ts --demo",
    "specimens": "tsx eval/export-cases.ts && python3 tools/gen_specimens.py",
    "eval:oracle": "tsx eval/extract-eval.ts --mode oracle",
    "eval:live": "tsx eval/extract-eval.ts --mode live",
    "e2e": "tsx e2e/run.ts",
    "build": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start:dev": "tsx src/server/index.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "promote-pack": "tsx scripts/promote-pack.ts",
    "verify-sheet": "tsx scripts/verify-sheet.ts",
    "smoke": "tsx scripts/smoke-remote.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "ingest": "tsx scripts/ingest.ts",
    "new-pack": "tsx scripts/new-pack.ts",
    "eval:rag": "tsx eval/rag/run.ts",
    "eval:rag-live": "tsx eval/rag/live.ts",
    "eval:noisy": "tsx eval/rag/noisy-run.ts",
    "agency": "tsx src/server/index.ts --demo",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}